<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Needed to list every installed app on Android 11+, which is the point of Pluck. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Phone checkup: screen time, unused apps and real app sizes, only after the user allows usage access in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Recorder keeps recording with the screen off; Teleprompter films with the camera. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only asked for when the user turns on "new screen recordings"; it lets Ultimate notice them. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Files: a file manager needs all-files access (asked for in the tool, not at install) and permission to install APKs. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Asked only from Notification history, so Samsung does not put the listener to sleep. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- The terminal's vibrate command. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The floating orb draws over other apps once the user allows it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application android:requestLegacyExternalStorage="true">
        <service android:name=".orb.OrbService" android:exported="false" />
        <!-- Notification history: Android hands notifications to this only after the user turns on notification access. -->
        <service
            android:name=".inbox.NotificationCatcher"
            android:exported="true"
            android:label="Ultimate notification history"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Clipboard: a moment in front to read the clipboard, or to receive selected / shared text. -->
        <activity
            android:name=".clips.ClipCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Save to Ultimate"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".clips.ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="Save clip"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".files.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay" />
        <activity
            android:name=".files.InstallStatusActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ultimate.Overlay" />
        <!-- "Share clean" in every share menu: removes location and camera details, then passes the file on. -->
        <activity
            android:name=".clean.ShareCleanActivity"
            android:exported="true"
            android:label="Share clean"
            android:icon="@mipmap/ic_launcher"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".recorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
