<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- The traffic inspector relays the chosen apps' connections itself, and Phone checkup's "Ask AI" calls Anthropic with the user's own key, so this edition (and only this and the standalone inspector) needs the internet permission. -->
    <!-- Lets the Uninstall buttons work: from Android 9 the system's uninstall screen refuses an app that has not declared this. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="replace" />
    <!-- Needed to list every installed app on Android 11+, which is the point of Pluck. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Phone checkup: screen time, unused apps and real app sizes, only after the user allows usage access in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Network scanner: listening for mDNS and UPnP announcements on the local Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Home search: find people by name. Only asked for when "Search your contacts too" is tapped. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Spatial (opt-in): Wi-Fi networks heard, your watch's Bluetooth beacon, steps for walking a signal map. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Recorder keeps recording with the screen off; Teleprompter films with the camera. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Only asked for when the user turns on "new screen recordings"; it lets Ultimate notice them. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Files: a file manager needs all-files access (asked for in the tool, not at install) and permission to install APKs. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Send to computer keeps sharing while Ultimate is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Asked only from Notification history, so Samsung does not put the listener to sleep. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Footprint: read-only Health Connect access, asked one type at a time and only after the user taps the button. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- Health: each kind is asked for only when you turn it on in the Health tool. -->
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <queries><package android:name="com.google.android.apps.healthdata" /></queries>
    <!-- The terminal's vibrate command. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The floating orb draws over other apps once the user allows it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Rules: start again after a restart, change Do Not Disturb when the user allows it, and watch the phone while any rule needs it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Footprint: optional step counting, only after the user taps Start. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application android:requestLegacyExternalStorage="true">
        <!-- Room scan uses ARCore when the phone has it; the app installs and runs without it. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />
        <service android:name="app.ultimate.player.PlaybackService" android:exported="true" android:foregroundServiceType="mediaPlayback">
            <intent-filter><action android:name="androidx.media3.session.MediaSessionService" /></intent-filter>
        </service>
        <!-- "Open with Ultimate+": a player for any audio, video or picture opened from another app. -->
        <activity android:name="app.ultimate.player.PlayerActivity" android:exported="true" android:theme="@style/Theme.Ultimate" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service android:name="app.ultimate.spatial.SpatialService" android:exported="false" android:foregroundServiceType="connectedDevice|location" />
        <!-- Air mode: the camera watches your hand while you use other apps (started only from Air control, with Stop in its notification). -->
        <service android:name="app.ultimate.vision.AirModeService" android:exported="false" android:foregroundServiceType="camera" />
        <!-- Air mode's cursor and taps, in any app; turned on by you in Settings → Accessibility. -->
        <service android:name="app.ultimate.vision.AirCursorService" android:exported="true" android:label="Ultimate Air mode"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/air_cursor_service" />
        </service>

        <!-- Watch: Wear OS delivers the watch's gestures here; only Ultimate+ on the watch (same package and key) can send them. -->
        <service android:name="app.ultimate.watch.WatchListenerService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ultimate/watch" />
            </intent-filter>
        </service>
        <!-- Health Connect asks why the app wants health data, and lists it among apps with access. -->
        <activity android:name=".footprint.HealthRationaleActivity" android:exported="true">
            <intent-filter><action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" /></intent-filter>
        </activity>
        <activity-alias android:name="ViewPermissionUsageActivity" android:exported="true" android:targetActivity=".footprint.HealthRationaleActivity" android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".ssh.SshKeyScanActivity" android:exported="false" />
        <service android:name=".ssh.SshForegroundService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled SSH and SFTP server for approved computers, with visible disconnect controls" />
        </service>
        <service android:name=".orb.OrbService" android:exported="false" />
        <!-- Notification history: Android hands notifications to this only after the user turns on notification access. -->
        <service
            android:name=".inbox.NotificationCatcher"
            android:exported="true"
            android:label="Ultimate notification history"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Clipboard: a moment in front to read the clipboard, or to receive selected / shared text. -->
        <activity
            android:name=".clips.ClipCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Save to Ultimate"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".clips.ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="Save clip"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".files.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay" />
        <activity
            android:name=".files.InstallStatusActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ultimate.Overlay" />
        <!-- "Share clean" in every share menu: removes location and camera details, then passes the file on. -->
        <activity
            android:name=".clean.ShareCleanActivity"
            android:exported="true"
            android:label="Strip metadata &amp; share"
            android:icon="@mipmap/ic_launcher"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".traffic.engine.TrafficVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name=".send.LinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="Computer link"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Timeline: notes when the phone goes on and off the charger (time and battery level only). -->
        <receiver android:name=".timeline.ChargeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".focus.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Runs a focus session the user started: a countdown, and a check of which app is in front every 30 seconds" />
        </service>
        <service
            android:name=".rules.RulesService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Watches the charger, headphones, battery and Wi-Fi so the user's own rules can run" />
        </service>
        <receiver android:name=".rules.RulesBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".send.SendService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local file sharing between the user's own phone and computer on the same Wi-Fi" />
        </service>
        <!-- Home screen widget: one-tap actions and the last thing sensed. -->
        <receiver android:name=".home.QuickActionsWidget" android:exported="false" android:label="Ultimate">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_actions_info" />
        </receiver>
        <!-- Echo: sonar sensing with the speaker and mic, only while the user runs it; a notification with Stop is shown throughout. -->
        <!-- Octopus Mesh: keeps the mesh reachable while the app is in the background; shown with Stop the whole time it runs. -->
        <service android:name=".mesh.MeshService" android:exported="false" android:foregroundServiceType="connectedDevice|microphone" />
        <service
            android:name=".echo.EchoService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".recorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
