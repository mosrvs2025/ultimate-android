<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- The traffic inspector relays the chosen apps' connections itself, and Phone checkup's "Ask AI" calls Anthropic with the user's own key, so this edition (and only this and the standalone inspector) needs the internet permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="replace" />
    <!-- Needed to list every installed app on Android 11+, which is the point of Pluck. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Phone checkup: screen time, unused apps and real app sizes, only after the user allows usage access in Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Network scanner: listening for mDNS and UPnP announcements on the local Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Recorder keeps recording with the screen off; Teleprompter films with the camera. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only asked for when the user turns on "new screen recordings"; it lets Ultimate notice them. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Files: a file manager needs all-files access (asked for in the tool, not at install) and permission to install APKs. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Send to computer keeps sharing while Ultimate is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Asked only from Notification history, so Samsung does not put the listener to sleep. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- The terminal's vibrate command. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The floating orb draws over other apps once the user allows it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Rules: start again after a restart, change Do Not Disturb when the user allows it, and watch the phone while any rule needs it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Footprint: optional step counting, only after the user taps Start. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application android:requestLegacyExternalStorage="true">
        <activity android:name=".ssh.SshKeyScanActivity" android:exported="false" />
        <service android:name=".ssh.SshForegroundService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled SSH and SFTP server for approved computers, with visible disconnect controls" />
        </service>
        <service android:name=".orb.OrbService" android:exported="false" />
        <!-- Notification history: Android hands notifications to this only after the user turns on notification access. -->
        <service
            android:name=".inbox.NotificationCatcher"
            android:exported="true"
            android:label="Ultimate notification history"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Clipboard: a moment in front to read the clipboard, or to receive selected / shared text. -->
        <activity
            android:name=".clips.ClipCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Save to Ultimate"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".clips.ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="Save clip"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".files.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay" />
        <activity
            android:name=".files.InstallStatusActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Ultimate.Overlay" />
        <!-- "Share clean" in every share menu: removes location and camera details, then passes the file on. -->
        <activity
            android:name=".clean.ShareCleanActivity"
            android:exported="true"
            android:label="Share clean"
            android:icon="@mipmap/ic_launcher"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Ultimate.Overlay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".traffic.engine.TrafficVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name=".send.LinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="Computer link"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".rules.RulesService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Watches the charger, headphones, battery and Wi-Fi so the user's own rules can run" />
        </service>
        <receiver android:name=".rules.RulesBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".send.SendService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local file sharing between the user's own phone and computer on the same Wi-Fi" />
        </service>
        <service
            android:name=".recorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
