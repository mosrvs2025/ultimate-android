<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />
    <!-- Wrist gestures use the motion sensors; vibration confirms each one. Nothing else. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Updates sent from Ultimate+ on the phone; Android still asks for a tap on every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Heart rate, only after "Share heart rate" is turned on; it goes to Ultimate+ on the phone and nowhere else. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">
        <!-- Runs on its own: no phone app is required for it to open, it just finds Ultimate+ when it can. -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Receives updates the phone sends (only Ultimate+ on the phone, same package and key, can). -->
        <service android:name=".WatchUpdateService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ultimate/update" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ultimate/phone" />
            </intent-filter>
        </service>
        <receiver android:name=".UpdateResult" android:exported="false" />
    </application>
</manifest>
